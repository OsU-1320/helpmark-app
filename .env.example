# Firebase設定（Firebaseコンソール > プロジェクトの設定 > マイアプリ から取得）
# コピーして .env を作成し、値を埋めてください。.env はコミットしないこと。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push通知用のVAPIDキー（Firebaseコンソール > プロジェクトの設定 > Cloud Messaging）
VITE_FIREBASE_VAPID_KEY=

# 支援要請API（Cloudflare Worker）のベースURL。例: https://your-api.example.com
# ローカル開発では http://localhost:8787（server/ で wrangler dev を起動）
VITE_ALERT_API_BASE=

# アプリ本体のURL（NFCタグに書き込むURLの基準）。未設定なら開いているURLを使う
VITE_APP_ORIGIN=
